@startuml
title OGC API MCP Reference Server - Internal Classes

skinparam classAttributeIconSize 0

class ProxyRuntime {
  registry
  client
  common
  features
  records
  processes
  capabilities
  fallbacks
  memory
  sanitizer
  process_descriptions
  planner
  workflow
  policy
}

class ServerRegistry {
  get(server_id, service)
  list()
  enabled_servers()
}

class OgcHttpClient {
  request(server, method, path)
}

class CommonService
class FeaturesService
class RecordsService
class ProcessesService

class CapabilityCache {
  get(server_id, refresh)
  bootstrap()
}

class FallbackEngine {
  active_for(profile)
  choose_execution_mode(mode, profile)
}

class ProxyPlanner {
  create_plan(request)
  update_plan(plan_id, execute_request)
  confirm_plan(plan_id, approved)
  execute_plan(plan_id)
  list_plans()
}

class PlanningWorkflow {
  create_plan(plan_request)
  confirm_plan(plan_id, approved)
  execute_plan(plan_id)
}

class ProxyMemoryStore {
  store(operation, server_id, data, summary)
  retrieve(handle, offset, limit)
  list_metadata()
}

interface KeyValueStore {
  put(key, value, ttl_seconds)
  get(key)
  list_values()
}

class InMemoryStore
class RedisStore
class ResponseSanitizer
class ProcessDescriptionCache
class TokenManager

ProxyRuntime --> ServerRegistry
ProxyRuntime --> OgcHttpClient
ProxyRuntime --> CommonService
ProxyRuntime --> FeaturesService
ProxyRuntime --> RecordsService
ProxyRuntime --> ProcessesService
ProxyRuntime --> CapabilityCache
ProxyRuntime --> FallbackEngine
ProxyRuntime --> ProxyMemoryStore
ProxyRuntime --> ResponseSanitizer
ProxyRuntime --> ProcessDescriptionCache
ProxyRuntime --> ProxyPlanner
ProxyRuntime --> PlanningWorkflow

CommonService --> ServerRegistry
FeaturesService --> ServerRegistry
RecordsService --> ServerRegistry
ProcessesService --> ServerRegistry

CommonService --> OgcHttpClient
FeaturesService --> OgcHttpClient
RecordsService --> OgcHttpClient
ProcessesService --> OgcHttpClient

OgcHttpClient --> TokenManager
ProxyPlanner --> FeaturesService
ProxyPlanner --> ProcessesService
ProxyPlanner --> ProcessDescriptionCache
ProxyPlanner --> KeyValueStore
ProxyMemoryStore --> KeyValueStore
InMemoryStore ..|> KeyValueStore
RedisStore ..|> KeyValueStore
PlanningWorkflow --> ProxyPlanner
PlanningWorkflow --> CapabilityCache
PlanningWorkflow --> FallbackEngine

@enduml
