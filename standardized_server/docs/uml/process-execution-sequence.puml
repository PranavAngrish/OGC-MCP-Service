@startuml
title Proxy Process Execution Sequence

actor User
participant "MCP Client" as Client
participant "FastMCP Tools\napp.py" as App
participant "PlanningWorkflow" as Workflow
participant "ProxyPlanner" as Planner
participant "ProcessesService" as Processes
participant "FeaturesService" as Features
database "Plan Store" as Store
participant "OGC Processes API" as OGC

User -> Client : request geospatial process
Client -> App : ogc_processes_list
App -> Processes : list_processes()
Processes -> OGC : GET /processes
OGC --> Processes : process list
Processes --> App : result envelope
App --> Client : summarized result

Client -> App : ogc_processes_describe(process_id)
App -> Processes : describe(process_id)
Processes -> OGC : GET /processes/{id}
OGC --> Processes : process description
Processes --> App : result envelope
App --> Client : process schema

Client -> App : ogc_proxy_create_plan(plan_request_json)
App -> Workflow : create_plan(request)
Workflow -> Planner : create_plan(request)
Planner -> Processes : describe(process_id)
Processes -> OGC : GET /processes/{id}
OGC --> Processes : process description

alt request declares feature sources
  Planner -> Features : describe_collection(collection_id, server_id)
  Features --> Planner : collection metadata
end

Planner -> Store : put(plan)
Planner --> Workflow : ProxyPlan

alt needs resolution
  Workflow --> App : resolution_required
  App --> Client : per-field questions
  Client -> User : ask one question
  User --> Client : answer
  Client -> App : ogc_proxy_update_plan(plan_id, execute_request_json)
  App -> Planner : update_plan(...)
  Planner -> Store : put(updated plan)
else ready for confirmation
  Workflow --> App : confirmation_prompt
  App --> Client : execute_request
  Client -> User : show exact execute_request
  User --> Client : approves
end

Client -> App : ogc_proxy_confirm_plan(plan_id, approved=true)
App -> Workflow : confirm_plan(...)
Workflow -> Planner : confirm_plan(...)
Planner -> Store : put(confirmed plan)
Workflow --> App : confirmed

Client -> App : ogc_proxy_execute_plan(plan_id)
App -> Workflow : execute_plan(...)
Workflow -> Planner : execute_plan(...)
Planner -> Store : put(running)
Planner -> Processes : execute(process_id, stored execute_request)
Processes -> OGC : POST /processes/{id}/execution
OGC --> Processes : result or job metadata
Processes --> Planner : result envelope
Planner -> Store : put(completed)
Workflow --> App : result envelope
App --> Client : summary or raw response
Client --> User : final result

@enduml
