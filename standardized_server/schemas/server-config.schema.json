{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://52north.org/ogc-mcp/schemas/server-config.schema.json",
  "title": "OGC API MCP Reference Server Configuration",
  "type": "object",
  "required": ["servers"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "default_servers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "servers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/server"
      }
    },
    "store": {
      "$ref": "#/$defs/store"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "server": {
      "type": "object",
      "required": ["id", "base_url", "services"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "base_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "services": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["common", "features", "records", "processes"]
          }
        },
        "paths": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "defaults": {
          "type": "object"
        },
        "auth": {
          "$ref": "#/$defs/auth"
        },
        "security": {
          "$ref": "#/$defs/security"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "properties": {
        "type": {
          "enum": ["none", "bearer_env", "api_key_env", "basic_env", "jwt_bearer"]
        },
        "token_env": {
          "type": "string"
        },
        "api_key_env": {
          "type": "string"
        },
        "api_key_header": {
          "type": "string"
        },
        "username_env": {
          "type": "string"
        },
        "password_env": {
          "type": "string"
        },
        "login_path": {
          "type": "string",
          "pattern": "^/"
        },
        "refresh_path": {
          "type": "string",
          "pattern": "^/"
        },
        "token_json_path": {
          "type": "string"
        },
        "refresh_token_json_path": {
          "type": "string"
        },
        "expires_in_json_path": {
          "type": "string"
        },
        "refresh_window_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "properties": {
        "allow_private_networks": {
          "type": "boolean",
          "default": false
        },
        "allowed_reference_hosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allow_unlisted_reference_hosts": {
          "type": "boolean",
          "default": false
        },
        "validate_execute_references": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "store": {
      "type": "object",
      "description": "Pluggable backend for proxy plan and proxy-memory state. backend=\"memory\" (default) is process-local and only correct for a single-worker stdio deployment. backend=\"redis\" is required for a multi-worker or multi-replica streamable-http deployment.",
      "properties": {
        "backend": {
          "enum": ["memory", "redis"],
          "default": "memory"
        },
        "redis_url_env": {
          "type": "string",
          "description": "Name of the environment variable holding the Redis connection URL. Required when backend is \"redis\"."
        },
        "key_prefix": {
          "type": "string",
          "default": "ogc_mcp"
        },
        "plan_ttl_seconds": {
          "type": "integer",
          "minimum": 0,
          "default": 3600,
          "description": "0 disables expiry."
        },
        "memory_ttl_seconds": {
          "type": "integer",
          "minimum": 0,
          "default": 1800,
          "description": "0 disables expiry."
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "description": "Operator-controlled toggles for the MCP tool surface itself.",
      "properties": {
        "expose_direct_execution_tools": {
          "type": "boolean",
          "default": false,
          "description": "When false (default), ogc_processes_execute is not registered at all, so it cannot be called without going through the ogc_proxy_create_plan / ogc_proxy_confirm_plan human-confirmation gate. Enable only for low-level interoperability testing."
        }
      },
      "additionalProperties": false
    }
  }
}
