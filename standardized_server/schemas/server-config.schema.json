{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://52north.org/ogc-mcp/schemas/server-config.schema.json",
  "title": "OGC API MCP Reference Server Configuration",
  "type": "object",
  "required": ["servers"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "default_servers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "servers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/server"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "server": {
      "type": "object",
      "required": ["id", "base_url", "services"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "base_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "services": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["common", "features", "records", "processes"]
          }
        },
        "paths": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "defaults": {
          "type": "object"
        },
        "auth": {
          "$ref": "#/$defs/auth"
        },
        "security": {
          "$ref": "#/$defs/security"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "properties": {
        "type": {
          "enum": ["none", "bearer_env", "api_key_env", "basic_env"]
        },
        "token_env": {
          "type": "string"
        },
        "api_key_env": {
          "type": "string"
        },
        "api_key_header": {
          "type": "string"
        },
        "username_env": {
          "type": "string"
        },
        "password_env": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "properties": {
        "allow_private_networks": {
          "type": "boolean",
          "default": false
        },
        "allowed_reference_hosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allow_unlisted_reference_hosts": {
          "type": "boolean",
          "default": false
        },
        "validate_execute_references": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  }
}
