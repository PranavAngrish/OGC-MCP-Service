# Required by the server-side gateway. Never expose this through VITE_* variables.
GEMINI_API_KEY=

# Gemini's OpenAI-compatible API is used through the existing OpenAI JS SDK.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_REASONING_EFFORT=medium

# Existing OGC MCP server configuration.
OGC_MCP_CONFIG=../standardized_server/config.example.json
OGC_MCP_PYTHON=../venv/bin/python
# Slow remote catalogue searches may span several OGC API pages.
OGC_MCP_TOOL_TIMEOUT_MS=180000

UI_GATEWAY_PORT=8787

# Confirmed asynchronous jobs continue updating the originating response.
OGC_JOB_POLL_INTERVAL_MS=3000
OGC_JOB_MONITOR_TIMEOUT_MS=1800000

# Browser-visible MapLibre style. The official MapLibre demo style makes local
# validation work out of the box. Replace it for production, or leave it empty
# to use the private network-free canvas.
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
